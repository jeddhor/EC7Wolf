<?xml version="1.0" encoding="utf-8"?>
<!-- The frame around the first-run dialog. The dialog's own window background
     is made transparent in IntroDialog so that this, and its corners, are what
     the player sees. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >

    <solid android:color="#ff101014" />
    <stroke
        android:width="2dp"
        android:color="@color/holo_blue" />
    <corners android:radius="6dp" />
</shape>
